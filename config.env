# ========================================
# KernelSU Build Configuration
# Device: Realme 9 5G Speed Edition (RMX3461)
# ========================================

# Kernel Source Configuration
KERNEL_SOURCE=https://github.com/realme-kernel-opensource/realme_GTmaster_Q3s_Q3t_9-5G-Speed-AndroidT-kernel-source
KERNEL_SOURCE_BRANCH=master

# Kernel Config (defconfig file name)
# Based on kernel source documentation: lahaina_defconfig
# Alternative options if build fails:
# - vendor/lahaina-qgki_defconfig
# - vendor/oplus_defconfig  
KERNEL_CONFIG=lahaina_defconfig

# Architecture
ARCH=arm64

# Kernel Image Name
# Common options: Image, Image.gz, Image.gz-dtb
KERNEL_IMAGE_NAME=Image

# ========================================
# Clang Configuration
# ========================================
USE_CUSTOM_CLANG=false
CLANG_BRANCH=android12-release
CLANG_VERSION=r416183b

# Custom Clang (if USE_CUSTOM_CLANG=true)
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# ========================================
# GCC Configuration
# ========================================
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

# ========================================
# Extra Build Commands
# ========================================
EXTRA_CMDS=LLVM=1 LLVM_IAS=1

# ========================================
# KernelSU Configuration
# ========================================
ENABLE_KERNELSU=true

# IMPORTANT: Use v0.9.5 for non-GKI devices
# KernelSU 1.0+ does NOT support non-GKI kernels!
KERNELSU_TAG=v0.9.5

# Custom KernelSU Manager signature (leave default for official manager)
KSU_EXPECTED_SIZE=0x033b
KSU_EXPECTED_HASH=c371061b19d8c7d7d6133c6a9bafe198fa944e50c1b31c9d8daa8d7f1fc2d2d6

# ========================================
# Build Options
# ========================================
# Disable LTO if build fails with memory errors
DISABLE_LTO=false

# Disable CC_WERROR to fix warning-as-error issues
DISABLE_CC_WERROR=true

# Auto-inject Kprobes config into defconfig
ADD_KPROBES_CONFIG=true

# Auto-inject overlayfs config for module support
ADD_OVERLAYFS_CONFIG=true

# Apply KernelSU manual patches if kprobe doesn't work
APPLY_KERNELSU_PATCH=true

# Remove unused packages to save disk space
REMOVE_UNUSED_PACKAGES=true

# ========================================
# AnyKernel3 Configuration
# ========================================
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ========================================
# Other Options
# ========================================
# Enable ccache for faster rebuilds
ENABLE_CCACHE=true

# Upload DTBO (required for some devices)
NEED_DTBO=true

# Build boot.img (requires source boot image)
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ========================================
# KernelSU Build Configuration
# Device: Realme 9 5G Speed Edition (RMX3461)
# ========================================

# 保留你原来的官方源码，不换！
KERNEL_SOURCE=https://github.com/realme-kernel-opensource/realme_GTmaster_Q3s_Q3t_9-5G-Speed-AndroidT-kernel-source
KERNEL_SOURCE_BRANCH=master

# 保留原来的配置，不换！
KERNEL_CONFIG=lahaina_defconfig

# Architecture
ARCH=arm64
KERNEL_IMAGE_NAME=Image

# Clang / GCC 配置（别动）
USE_CUSTOM_CLANG=false
CLANG_BRANCH=android12-release
CLANG_VERSION=r416183b
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

# 强制开启SukiSU必需的配置
EXTRA_CMDS=LLVM=1 LLVM_IAS=1 CONFIG_KPROBES=y CONFIG_OVERLAY_FS=y

# ========================================
# 关键：SukiSU Ultra 配置
# ========================================
ENABLE_KERNELSU=true
KERNELSU_REPO=https://github.com/SukiSU-Android-Team/KernelSU
KERNELSU_TAG=sukisu

# 其他配置（别动）
KSU_EXPECTED_SIZE=0x033b
KSU_EXPECTED_HASH=0
DISABLE_LTO=false
DISABLE_CC_WERROR=true
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
APPLY_KERNELSU_PATCH=true
REMOVE_UNUSED_PACKAGES=true
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=
ENABLE_CCACHE=true
NEED_DTBO=true
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=
